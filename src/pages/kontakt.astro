---
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import { AUTHOR, FORM_ENDPOINT } from '../consts';
---

<Base
	title="Kontakt – Walter Uehli"
	description="Nimm Kontakt mit Walter Uehli auf oder bewirb dich als Testleser:in für den kommenden Thriller «Huwiler und der Organhandel»."
>
	<section class="section">
		<div class="container head prose">
			<span class="eyebrow">Kontakt</span>
			<h1>Schreib mir</h1>
			<p class="lead">
				Ob Rückmeldung zu einem Beitrag, eine Presseanfrage oder einfach ein Hallo – ich
				lese jede Nachricht. Und wer den nächsten Thriller vor allen anderen lesen möchte,
				bewirbt sich weiter unten als Testleser:in.
			</p>
			<div class="direct">
				<a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
				<a href={`tel:${AUTHOR.phoneHref}`}>{AUTHOR.phone}</a>
			</div>
			<SocialIcons size={22} />
		</div>
	</section>

	<section class="section forms">
		<div class="container form-grid">
			<!-- Kontaktformular -->
			<form class="card form" action={FORM_ENDPOINT} method="post" data-ajax>
				<h2>Nachricht senden</h2>
				<input type="hidden" name="_form" value="Kontakt" />
				<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<input type="hidden" name="_ts" class="ts-field" />
				<div class="field">
					<label for="name">Name</label>
					<input id="name" name="name" type="text" required />
				</div>
				<div class="field">
					<label for="email">E-Mail</label>
					<input id="email" name="email" type="email" required />
				</div>
				<div class="field">
					<label for="message">Nachricht</label>
					<textarea id="message" name="message" required></textarea>
				</div>
				<button type="submit" class="btn btn-primary">Absenden</button>
				<p class="form-status" role="status" aria-live="polite"></p>
			</form>

			<!-- Testleser-Bewerbung -->
			<form class="card form" action={FORM_ENDPOINT} method="post" data-ajax>
				<h2>Testleser:in werden</h2>
				<p class="muted small">
					Du bekommst das Manuskript vorab und gibst mir ehrliche Rückmeldung.
				</p>
				<input type="hidden" name="_form" value="Testleser" />
				<input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
				<input type="hidden" name="_ts" class="ts-field" />
				<div class="field">
					<label for="tl-name">Name</label>
					<input id="tl-name" name="name" type="text" required />
				</div>
				<div class="field">
					<label for="tl-email">E-Mail</label>
					<input id="tl-email" name="email" type="email" required />
				</div>
				<div class="field">
					<label for="tl-motivation">Warum möchtest du Testleser:in werden?</label>
					<textarea id="tl-motivation" name="motivation"></textarea>
				</div>
				<div class="field-row">
					<div class="field">
						<label for="tl-type">Was liest du am liebsten?</label>
						<select id="tl-type" name="lesertyp">
							<option>Thriller / Krimi</option>
							<option>Spannung allgemein</option>
							<option>Querbeet</option>
						</select>
					</div>
					<div class="field">
						<label for="tl-format">Format</label>
						<select id="tl-format" name="format">
							<option>E-Book (PDF/EPUB)</option>
							<option>Gedruckt</option>
							<option>Egal</option>
						</select>
					</div>
				</div>
				<div class="field checkbox">
					<label class="check">
						<input type="checkbox" name="vertraulichkeit" required />
						<span>Ich behandle das Manuskript vertraulich.</span>
					</label>
				</div>
				<button type="submit" class="btn btn-primary">Bewerbung senden</button>
				<p class="form-status" role="status" aria-live="polite"></p>
			</form>
		</div>
	</section>
</Base>

<style>
	.head {
		text-align: center;
	}
	.head .lead {
		margin-inline: auto;
		max-width: 54ch;
	}
	.direct {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
		margin: 1.5rem 0 1rem;
		font-family: var(--font-serif);
		font-size: 1.15rem;
	}
	.head :global(.social-icons) {
		justify-content: center;
	}
	.forms {
		padding-top: 0;
	}
	.form-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		align-items: start;
	}
	.form {
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.form h2 {
		margin: 0;
	}
	.form .small {
		font-size: 0.9rem;
		margin: -0.4rem 0 0;
	}
	.field-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}
	.check {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		font-weight: 400;
		color: var(--text-muted);
		text-transform: none;
		letter-spacing: 0;
		font-size: 0.9rem;
	}
	.check input {
		width: auto;
		margin-top: 0.2rem;
	}
	/* Honeypot – für Menschen unsichtbar */
	.hp {
		position: absolute;
		left: -5000px;
		width: 1px;
		height: 1px;
		opacity: 0;
		pointer-events: none;
	}
	.form-status {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		min-height: 1.2em;
	}
	.form-status.ok {
		color: #7bbf8a;
	}
	.form-status.err {
		color: var(--accent-hover);
	}
	.form.sent .field,
	.form.sent .field-row,
	.form.sent button,
	.form.sent .checkbox {
		display: none;
	}
	@media (max-width: 820px) {
		.form-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>('form[data-ajax]');
	forms.forEach((form) => {
		const status = form.querySelector<HTMLElement>('.form-status');
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form.reportValidity()) return;
			const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
			if (status) {
				status.className = 'form-status';
				status.textContent = 'Wird gesendet …';
			}
			if (btn) btn.disabled = true;
			try {
				const res = await fetch(form.action, {
					method: 'POST',
					body: new FormData(form),
					headers: { Accept: 'application/json' },
				});
				let data: any = {};
				try { data = await res.json(); } catch {}
				if (res.ok && data.ok !== false) {
					form.classList.add('sent');
					if (status) {
						status.className = 'form-status ok';
						status.textContent = 'Vielen Dank! Deine Nachricht ist unterwegs. Ich melde mich.';
					}
				} else {
					throw new Error(data.error || 'Senden fehlgeschlagen.');
				}
			} catch (err) {
				if (status) {
					status.className = 'form-status err';
					status.textContent =
						(err as Error).message ||
						'Es gab ein Problem. Bitte später erneut versuchen oder direkt per E-Mail schreiben.';
				}
				if (btn) btn.disabled = false;
			}
		});
	});

	// Timing-Feld beim Laden setzen (Spam-Schutz)
	document.querySelectorAll<HTMLInputElement>('.ts-field').forEach((el) => {
		el.value = String(Math.floor(Date.now() / 1000));
	});
</script>
