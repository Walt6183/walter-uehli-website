---
import Base from '../layouts/Base.astro';
---

<Base
	title="Newsletter – Tatort-Post | Walter Uehli"
	description="Melde dich zur Tatort-Post an: Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach."
>
	<section class="section">
		<div class="container head prose">
			<span class="eyebrow">Newsletter</span>
			<h1>Tatort-Post</h1>
			<p class="lead">
				Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und die
				Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach. Kein Spam, jederzeit
				abbestellbar.
			</p>
		</div>
	</section>

	<section class="section forms">
		<div class="container">
			<div class="cr-wrap">
				<Fragment set:html={`
<style>.cr-nope{display:none!important}.cr-web-wrapper{display:flex;justify-content:center}.cr-web-row{width:100%;max-width:520px;box-sizing:border-box}.cr-web-form{display:flex;flex-direction:column}.cr-web-form input{padding:0.8rem 1rem;border-radius:6px;border:1px solid #ccc;font-size:1rem;margin-bottom:0.5rem}.cr-web-form label{font-weight:500;padding:6px 0 2px;font-size:0.9rem;color:#555}.cr-web-form label.required:after{content:' *'}.cr-web-form button{padding:0.8rem 1rem;background:#313a3a;color:#fff;font-size:1rem;font-weight:700;border:none;border-radius:4px;cursor:pointer;margin-top:0.5rem}.cr-web-form button:hover{background:#d0b562}h1.nl-title{font-size:1.4rem;margin:0 0 1.5rem}</style>
<form method="post" action="https://flow.cleverreach.com/fl/0890aa50-717b-4501-a93b-7df2d1ed1785/confirm" target="_blank">
<input type="text" tabindex="-1" autocomplete="false" style="display:none !important;" name="email_confirm">
<div class="cr-web-wrapper"><div class="cr-web-row" style="padding:10px 0">
<h1 class="nl-title">Anmeldung zum Newsletter</h1>
<div class="cr-web-form">
<label class="required">Vorname</label>
<input type="text" name="global.firstname" required placeholder="">
<label class="required">E-Mail</label>
<input type="email" name="email" required placeholder="">
<button type="submit">Anmelden</button>
</div></div></div>
</form>`} />
			</div>
			<p class="hint muted text-center">Anmeldung über CleverReach · jederzeit abbestellbar</p>
		</div>
	</section>
</Base>

<style>
	.head { text-align: center; }
	.head .lead { margin-inline: auto; max-width: 52ch; }
	.forms { padding-top: 0; }
	.cr-wrap { max-width: 520px; margin-inline: auto; }
	.hint { margin-top: 1.5rem; font-size: 0.85rem; }
</style>
