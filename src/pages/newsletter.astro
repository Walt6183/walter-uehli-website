---
import Base from '../layouts/Base.astro';
---

<Base
	title="Newsletter – Tatort-Post | Walter Uehli"
	description="Melde dich zur Tatort-Post an."
>
	<section class="section">
		<div class="container head prose">
			<span class="eyebrow">Newsletter</span>
			<h1>Tatort-Post</h1>
			<p class="lead">
				Die Newsletter-Anmeldung ist momentan wegen technischer Wartungsarbeiten
				vorübergehend nicht verfügbar.
			</p>
			<p class="muted">
				Bitte versuche es in Kürze wieder — wir sind gleich zurück. Danke für dein Verständnis!
			</p>
		</div>
	</section>
</Base>

<style>
	.head {
		text-align: center;
		max-width: 52ch;
		margin-inline: auto;
	}
	.head .lead {
		margin-inline: auto;
		max-width: 52ch;
	}
</style>
