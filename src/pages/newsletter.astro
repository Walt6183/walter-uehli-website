---
import Base from '../layouts/Base.astro';
---

<Base
	title="Newsletter – Tatort-Post | Walter Uehli"
	description="Melde dich zur Tatort-Post an: Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach."
>
	<section class="section">
		<div class="container head prose">
			<span class="eyebrow">Newsletter</span>
			<h1>Tatort-Post</h1>
			<p class="lead">
				Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und die
				Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach. Kein Spam, jederzeit
				abbestellbar.
			</p>
		</div>
	</section>

	<section class="section forms">
		<div class="container">
			<div class="card cr-embed">
				<style hash="cr-web-css" is:global>
					.cr-embed .cr-web-form{display:flex;flex-direction:column}
					.cr-embed .cr-web-form input{padding:0.8rem 1rem;border-radius:var(--radius-sm);border:1px solid var(--border);background:var(--bg-elevated);color:var(--text);font-family:var(--font-sans);font-size:1rem;margin-bottom:0.75rem}
					.cr-embed .cr-web-form label{font-weight:500;padding-bottom:4px;display:block;color:var(--text-muted);font-family:var(--font-sans);font-size:0.85rem}
					.cr-embed .cr-web-form label.required:after{content:' *'}
					.cr-embed h1{font-size:1.4rem;margin:0 0 1.5rem 0}
					.cr-embed button{width:100%;padding:0.8rem 1rem;background:var(--accent);color:#fff;font-size:1rem;font-weight:700;border:none;border-radius:4px;cursor:pointer;transition:background 0.18s ease}
					.cr-embed button:hover{background:var(--accent-hover)}
					.cr-embed button:disabled{opacity:0.6;cursor:not-allowed}
					#nl-status{margin-top:1rem;padding:0.75rem 1rem;border-radius:4px;font-family:var(--font-sans);font-size:0.9rem;display:none}
				</style>

				<h1>Anmeldung zum Newsletter</h1>

				<form id="cr-newsletter-form" class="cr-web-form">
					<label class="required">Vorname</label>
					<input type="text" name="global.firstname" required placeholder="">

					<label class="required">E-Mail</label>
					<input type="email" name="email" required placeholder="">

					<button type="submit">Anmelden</button>
					<div id="nl-status"></div>
				</form>

				<script>
					const form = document.getElementById('cr-newsletter-form');
					const status = document.getElementById('nl-status');

					form?.addEventListener('submit', async (e) => {
						e.preventDefault();
						const btn = form.querySelector('button');
						btn.disabled = true;
						btn.textContent = 'Wird gesendet…';
						status.style.display = 'none';

						const data = new FormData(form);
						const params = new URLSearchParams();
						params.append('email', data.get('email'));
						params.append('global.firstname', data.get('global.firstname'));
						params.append('email_confirm', '');

						try {
							const res = await fetch(
								'https://flow.cleverreach.com/fl/0890aa50-717b-4501-a93b-7df2d1ed1785/confirm',
								{
									method: 'POST',
									headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
									body: params.toString(),
									mode: 'no-cors'
								}
							);
							// no-cors gibt immer opaque response — wir zeigen Erfolg
							status.style.display = 'block';
							status.style.background = '#d4edda';
							status.style.color = '#155724';
							status.textContent = '✅ Fast geschafft! Bitte bestätige deine Anmeldung per E-Mail.';
							form.querySelector('input[type="email"]').value = '';
							form.querySelector('input[type="text"]').value = '';
							btn.textContent = 'Gesendet';
						} catch (err) {
							status.style.display = 'block';
							status.style.background = '#f8d7da';
							status.style.color = '#721c24';
							status.textContent = 'Fehler. Bitte versuche es direkt auf CleverReach.';
							btn.disabled = false;
							btn.textContent = 'Anmelden';
						}
					});
				</script>
			</div>
			<p class="hint muted text-center">Anmeldung über CleverReach · jederzeit abbestellbar</p>
		</div>
	</section>
</Base>

<style>
	.head { text-align: center; }
	.head .lead { margin-inline: auto; max-width: 52ch; }
	.forms { padding-top: 0; }
	.cr-embed { max-width: 520px; margin-inline: auto; padding: 2rem; }
	.hint { margin-top: 1.5rem; font-size: 0.85rem; }
</style>
