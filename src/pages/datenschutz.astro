---
import Base from '../layouts/Base.astro';
---

<Base
	title="Datenschutz – Walter Uehli"
	description="Datenschutzerklärung von walter-uehli.ch."
>
	<section class="section">
		<div class="container prose">
			<h1>Datenschutz</h1>

			<!-- PrivacyBee: lädt die aktuelle Datenschutzerklärung -->
			<privacybee-widget website-id="cm5cbolgb001xm2ibd184k58e" type="dsg" lang="de"
			></privacybee-widget>

			<noscript>
				<p class="muted">
					Zur Anzeige der Datenschutzerklärung wird JavaScript benötigt. Alternativ findest du
					sie unter <a href="https://walter-uehli.ch/datenschutz/">walter-uehli.ch/datenschutz</a>.
				</p>
			</noscript>
		</div>
	</section>
</Base>

<!-- PrivacyBee-Widget-Skript (unverändert von Astro einbinden) -->
<script is:inline data-jetpack-boost="ignore" src="https://app.privacybee.io/widget.js" defer></script>
