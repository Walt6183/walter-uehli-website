	},
	{
		key: 'facebook',
		href: SOCIAL.facebook,
		label: 'Facebook',
		path: 'M9.1 14v-5.5h1.85l.28-2.15H9.1V4.98c0-.62.17-1.05 1.06-1.05h1.13V2.01c-.2-.03-.87-.09-1.65-.09-1.63 0-2.75 1-2.75 2.83v1.58H5.03V8.5h1.86V14H9.1Z',
	},
	{
		key: 'linkedin',
		href: SOCIAL.linkedin,
		label: 'LinkedIn',
		path: 'M4.98 3.5a1.48 1.48 0 1 1-.02 2.96 1.48 1.48 0 0 1 .02-2.96ZM3.75 6.9h2.46V14H3.75V6.9Zm4.2 0h2.36v.97h.03c.33-.6 1.13-1.23 2.32-1.23 2.48 0 2.94 1.56 2.94 3.59V14h-2.46v-3.28c0-.78-.02-1.79-1.1-1.79-1.1 0-1.27.83-1.27 1.73V14H7.95V6.9Z',
	},
	{
		key: 'whatsapp',
		href: SOCIAL.whatsapp,
		label: 'WhatsApp',
		path: 'M8 2.2A5.8 5.8 0 0 0 3.1 11l-.85 3.1 3.18-.83A5.8 5.8 0 1 0 8 2.2Zm0 1.2a4.6 4.6 0 0 1 3.9 7.03 4.6 4.6 0 0 1-6.2 1.55l-.22-.13-1.88.49.5-1.83-.14-.23A4.6 4.6 0 0 1 8 3.4Zm-1.7 2.2c-.1 0-.26.03-.4.19-.14.15-.53.51-.53 1.25s.54 1.45.62 1.55c.08.1 1.06 1.68 2.63 2.29 1.3.5 1.57.4 1.85.38.28-.03.9-.37 1.03-.72.13-.36.13-.66.09-.72-.04-.06-.14-.1-.3-.18-.15-.08-.9-.44-1.04-.49-.14-.05-.24-.08-.34.08-.1.15-.39.48-.48.58-.09.1-.18.11-.33.04-.15-.08-.64-.24-1.21-.75-.45-.4-.75-.9-.84-1.05-.09-.15-.01-.23.07-.31.07-.07.15-.18.23-.27.08-.09.1-.15.15-.25.05-.1.03-.19-.01-.27-.04-.08-.34-.83-.47-1.13-.12-.29-.24-.25-.34-.25Z',
	},
];

const visible = items.filter((i) => i.href && i.href.length > 0);
const { size = 20 } = Astro.props;
---

<div class="social-icons">
	{
		visible.map((i) => (
			<a href={i.href} target="_blank" rel="noopener noreferrer" aria-label={i.label}>
				<span class="sr-only">{i.label}</span>
				<svg viewBox="0 0 16 16" width={size} height={size} aria-hidden="true">
					<path fill="currentColor" d={i.path} />
				</svg>
			</a>
		))
	}
</div>

<style>
	.social-icons {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.social-icons a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		color: var(--text-muted);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-icons a:hover {
		color: #fff;
		background: var(--accent);
	}
</style>
