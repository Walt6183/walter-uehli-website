---
import { SITE_TITLE, NAV } from '../consts';
import SocialIcons from './SocialIcons.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="brand" aria-label={`${SITE_TITLE} – Startseite`}>
			<img src="/logo-header.png" alt={`${SITE_TITLE}, Autor`} width="2900" height="1500" />
		</a>

		<nav class="nav-desktop" aria-label="Hauptnavigation">
			{
				NAV.map((item) => (
					<a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="header-right">
			<SocialIcons size={18} />
			<button class="menu-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-nav">
				<svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
					<path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</button>
		</div>
	</div>

	<nav id="mobile-nav" class="nav-mobile" aria-label="Mobile Navigation" hidden>
		{
			NAV.map((item) => (
				<a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
					{item.label}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(26, 26, 26, 0.85);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		min-height: 76px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
	}
	.brand img {
		height: 54px;
		width: auto;
	}
	.nav-desktop {
		display: flex;
		gap: 0.4rem;
		margin-left: auto;
	}
	.nav-link {
		position: relative;
		padding: 0.5rem 0.9rem;
		font-family: var(--font-sans);
		font-size: 0.9rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: var(--text-muted);
	}
	.nav-link:hover {
		color: var(--text);
	}
	.nav-link.active {
		color: var(--text);
	}
	.nav-link.active::after {
		content: '';
		position: absolute;
		left: 0.9rem;
		right: 0.9rem;
		bottom: 0.15rem;
		height: 2px;
		background: var(--accent);
		border-radius: 2px;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.menu-toggle {
		display: none;
		background: transparent;
		border: none;
		color: var(--text);
		padding: 0.3rem;
		width: auto;
		cursor: pointer;
	}
	.nav-mobile {
		display: none;
		flex-direction: column;
		padding: 0.5rem 1.5rem 1.25rem;
		border-top: 1px solid var(--border);
	}
	.nav-mobile .nav-link {
		padding: 0.75rem 0;
		font-size: 1.05rem;
	}
	.nav-mobile .nav-link.active::after {
		display: none;
	}

	@media (max-width: 820px) {
		.nav-desktop {
			display: none;
		}
		.header-right :global(.social-icons) {
			display: none;
		}
		.menu-toggle {
			display: inline-flex;
		}
		.nav-mobile:not([hidden]) {
			display: flex;
		}
		.brand img {
			height: 46px;
		}
	}
</style>

<script>
	const toggle = document.querySelector('.menu-toggle');
	const mobileNav = document.getElementById('mobile-nav');
	toggle?.addEventListener('click', () => {
		const open = mobileNav?.hasAttribute('hidden');
		if (open) {
			mobileNav?.removeAttribute('hidden');
			toggle.setAttribute('aria-expanded', 'true');
		} else {
			mobileNav?.setAttribute('hidden', '');
			toggle.setAttribute('aria-expanded', 'false');
		}
	});
</script>
