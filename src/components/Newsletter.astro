---
// Newsletter «Tatort-Post» – Anmeldung über CleverReach.
// Aktuell: Button verlinkt auf das bestehende CleverReach-Anmeldeformular.
import { NEWSLETTER_URL } from '../consts';
const { compact = false } = Astro.props;
---

<section class:list={['newsletter', { compact }]}>
	<div class="container inner">
		<div class="nl-copy">
			<span class="eyebrow">Tatort-Post</span>
			<h2>Neuigkeiten direkt vom Autor</h2>
			<p class="muted">
				Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und die
				Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach. Kein Spam, jederzeit
				abbestellbar.
			</p>
		</div>
		<div class="nl-action">
			<a class="btn btn-primary" href={NEWSLETTER_URL} target="_blank" rel="noopener noreferrer">
				Tatort-Post abonnieren
			</a>
			<p class="hint muted">Anmeldung über CleverReach · jederzeit abbestellbar</p>
		</div>
	</div>
</section>

<style>
	.newsletter {
		background: var(--bg-soft);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding-block: clamp(3rem, 6vw, 5rem);
	}
	.inner {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.nl-copy h2 {
		margin-bottom: 0.5rem;
	}
	.nl-copy p {
		margin: 0;
		max-width: 46ch;
	}
	.nl-action {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
	}
	.hint {
		font-size: 0.8rem;
		margin: 0;
	}
	.compact .inner {
		grid-template-columns: 1fr;
		gap: 1.5rem;
		text-align: center;
	}
	.compact .nl-copy p {
		margin-inline: auto;
	}
	.compact .nl-action {
		align-items: center;
	}
	@media (max-width: 820px) {
		.inner {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
		.nl-action {
			align-items: flex-start;
		}
	}
</style>
