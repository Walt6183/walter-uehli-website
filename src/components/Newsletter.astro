---
// Newsletter-Anmeldung («Tatort-Post», CI). Das `action`-Attribut muss noch mit
// dem echten Anbieter (Brevo/Mailchimp) verbunden werden – siehe ANLEITUNG.md.
const { compact = false } = Astro.props;
---

<section class:list={['newsletter', { compact }]}>
	<div class="container inner">
		<div class="nl-copy">
			<span class="eyebrow">Tatort-Post</span>
			<h2>Neuigkeiten direkt vom Autor</h2>
			<p class="muted">
				Einblicke in den Schreibprozess, atmosphärische Bilder der Schauplätze und die
				Neuigkeiten rund um Fred Huwiler – direkt in dein Postfach. Kein Spam, jederzeit
				abbestellbar.
			</p>
		</div>
		<form class="nl-form" action="#" method="post" data-newsletter>
			<div class="fields">
				<label class="sr-only" for="nl-name">Vorname</label>
				<input id="nl-name" name="vorname" type="text" placeholder="Vorname" autocomplete="given-name" />
				<label class="sr-only" for="nl-email">E-Mail</label>
				<input id="nl-email" name="email" type="email" required placeholder="deine@email.ch" autocomplete="email" />
				<button class="btn btn-primary" type="submit">Abonnieren</button>
			</div>
			<p class="hint muted">Mit der Anmeldung stimmst du der Datenschutzerklärung zu.</p>
		</form>
	</div>
</section>

<style>
	.newsletter {
		background: var(--bg-soft);
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		padding-block: clamp(3rem, 6vw, 5rem);
	}
	.inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}
	.nl-copy h2 {
		margin-bottom: 0.5rem;
	}
	.nl-copy p {
		margin: 0;
		max-width: 46ch;
	}
	.fields {
		display: flex;
		gap: 0.6rem;
		flex-wrap: wrap;
	}
	.fields input {
		flex: 1 1 180px;
	}
	.fields .btn {
		flex: 0 0 auto;
	}
	.hint {
		font-size: 0.8rem;
		margin: 0.75rem 0 0;
	}
	.compact .inner {
		grid-template-columns: 1fr;
		gap: 1.5rem;
		text-align: center;
	}
	.compact .nl-copy p {
		margin-inline: auto;
	}
	.compact .fields {
		justify-content: center;
	}
	@media (max-width: 820px) {
		.inner {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>
